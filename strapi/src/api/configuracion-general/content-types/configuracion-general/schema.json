{
  "kind": "singleType",
  "collectionName": "configuracion_general",
  "info": {
    "singularName": "configuracion-general",
    "pluralName": "configuraciones-generales",
    "displayName": "Configuración General",
    "description": "Configuración transversal del sitio"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombreInstitucion": {
      "type": "string",
      "required": true,
      "default": "Institución Educativa El Diamante"
    },
    "escudo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "emailInstitucional": {
      "type": "email",
      "required": true
    },
    "telefonoPrincipal": {
      "type": "string"
    },
    "direccionPrincipal": {
      "type": "text"
    },
    "horarioAtencion": {
      "type": "richtext"
    },
    "enlacesGobierno": {
      "type": "component",
      "repeatable": true,
      "component": "shared.enlace"
    },
    "redesSociales": {
      "type": "component",
      "repeatable": true,
      "component": "shared.red-social"
    },
    "avisoLegalFooter": {
      "type": "string"
    },
    "seoDefault": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
