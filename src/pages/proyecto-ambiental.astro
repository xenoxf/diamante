---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FileViewer from '../components/FileViewer.astro';
import { institucionalService } from '../services/institucional.service';
import '../styles/global.css';
import '../styles/page.css';

const doc = institucionalService.getDocumentoById('proyecto-ambiental');
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Medio ambiente" title="Proyecto ambiental" />
    <div class="container">
      {doc && (
        <FileViewer src={doc.url} title="Proyecto Ambiental Escolar (PRAE)" format="PDF" />
      )}
    </div>
  </main>
  <Footer />
</Layout>
