---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { especialidadesService } from '../../services/especialidades.service';
import '../../styles/global.css';
import '../../styles/page.css';

const especialidades = especialidadesService.getEspecialidades();
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Oferta académica" title="Especialidades" />
    <div class="container container--wide">
      <p class="lead">
        La Institución Educativa El Diamante ofrece formación en distintas
        especialidades de la educación media, orientadas a la continuidad
        educativa y a la vinculación al mundo productivo.
      </p>
      <div class="grid">
        {especialidades.map((esp) => (
          <article class="card">
            <h2>{esp.nombre}</h2>
            <p>{esp.descripcion}</p>
            <a class="link" href={`/especialidades/${esp.slug}`}>Ver especialidad</a>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
