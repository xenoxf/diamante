---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { especialidadesService } from '../../services/especialidades.service';
import '../../styles/global.css';
import '../../styles/page.css';

export async function getStaticPaths() {
  return especialidadesService.getEspecialidades().map((e) => ({ params: { slug: e.slug }, props: { especialidad: e } }));
}

const { especialidad } = Astro.props;
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Oferta académica" title={especialidad.nombre} />
    <div class="container">
      <p class="lead">{especialidad.descripcion}</p>
      <p class="back"><a href="/especialidades">Volver a todas las especialidades</a></p>
    </div>
  </main>
  <Footer />
</Layout>
