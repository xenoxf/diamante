---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { galeriaService } from '../services/galeria.service';
import styles from '../styles/galeria.module.css';
import '../styles/global.css';
import '../styles/page.css';

const fotos = await galeriaService.getGaleriaImages(18);
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Galería" title="Galería institucional" />
    <div class="container container--full">
      <p class="intro">
        Registro fotográfico de las actividades académicas, culturales y deportivas
        de la Institución Educativa El Diamante.
      </p>
      <div class={styles.masonry}>
        {fotos.map((foto) => (
          <a
            class={styles.mItem}
            href={foto.src}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir fotografía en tamaño completo"
          >
            <img
              src={foto.src}
              width={foto.width}
              height={foto.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
