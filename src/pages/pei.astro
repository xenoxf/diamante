---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FileViewer from '../components/FileViewer.astro';
import { institucionalService } from '../services/institucional.service';
import '../styles/global.css';
import '../styles/page.css';

const doc = institucionalService.getDocumentoById('pei');
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Identidad institucional" title="Proyecto Educativo Institucional" />
    <div class="container">
      {doc && (
        <FileViewer src={doc.url} title={doc.titulo} format="PDF" />
      )}
    </div>
  </main>
  <Footer />
</Layout>
