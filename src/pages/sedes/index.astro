---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { sedesService } from '../../services/sedes.service';
import '../../styles/global.css';
import '../../styles/page.css';

const sedes = sedesService.getSedes();
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Nuestra institución" title="Sedes" />
    <div class="container container--wide">
      <p class="lead">
        La Institución Educativa El Diamante presta el servicio educativo en sus
        sedes ubicadas en Santiago de Cali. Seleccione una sede para consultar
        sus datos de contacto y su ubicación.
      </p>
      <div class="grid">
        {sedes.map((sede) => (
          <article class="card">
          <img src={sede.bannerUrl} alt="" />
            <h2>{sede.nombre}</h2>
            <p class="barrio">{sede.barrio}</p>
            <p class="address">{sede.direccion}</p>
            <a class="link" href={`/sedes/${sede.slug}`}>Ver sede</a>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
