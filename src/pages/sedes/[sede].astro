---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const { sedes } = await import('../../data/sedes');
  return sedes.map((s) => ({ params: { sede: s.slug }, props: { sede: s } }));
}

const { sede } = Astro.props;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(sede.mapQuery)}&output=embed`;
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Nuestras sedes" title={sede.nombre} />
    <div class="container">
      <dl class="data">
        <div>
          <dt>Barrio</dt>
          <dd>{sede.barrio}</dd>
        </div>
        <div>
          <dt>Dirección</dt>
          <dd>{sede.direccion}</dd>
        </div>
        <div>
          <dt>Teléfono</dt>
          <dd>{sede.telefono}</dd>
        </div>
        <div>
          <dt>Correo</dt>
          <dd><a href={`mailto:${sede.email}`}>{sede.email}</a></dd>
        </div>
      </dl>
      <h2>Ubicación</h2>
      <iframe
        class="map"
        title={`Mapa de ubicación de ${sede.nombre}`}
        src={mapSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <p class="back"><a href="/sedes">Volver a todas las sedes</a></p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page {
    background: #ffffff;
    color: #1a1d21;
    padding-bottom: 4rem;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }
  .data {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .data div {
    border: 1px solid #dfe3e8;
    border-left: 4px solid #07b9d5;
    padding: 0.9rem 1.1rem;
    line-height: 1.7;
  }
  .data dt {
    font-weight: 700;
    font-size: 0.9rem;
  }
  .data dd {
    margin: 0;
  }
  .data a {
    color: #06788a;
    text-decoration: underline;
  }
  h2 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .map {
    width: 100%;
    height: 380px;
    border: 1px solid #dfe3e8;
  }
  .back {
    margin-top: 1.5rem;
  }
  .back a {
    font-weight: 700;
    color: #06788a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
