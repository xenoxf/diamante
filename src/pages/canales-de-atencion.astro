---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { ciudadaniaService } from '../services/ciudadania.service';
import '../styles/global.css';
import '../styles/page.css';

const canales = ciudadaniaService.getCanales();
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Servicios a la ciudadanía" title="Canales de atención" />
    <div class="container">
      <p class="lead">
        La Institución Educativa El Diamante dispone los siguientes canales
        para la atención de estudiantes, acudientes y ciudadanía en general.
      </p>
      <p class="back">
        <a href="/contacto">Ir al formulario de contacto</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>
