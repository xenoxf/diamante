---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { institucionalService } from '../services/institucional.service';
import '../styles/global.css';
import '../styles/page.css';

const organigramaSrc = institucionalService.getDocumentoById('organigrama')?.url ?? '';
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Organización" title="Organigrama" />
    <div class="container">
      <p>
        <img
          class="figure-img"
          src={organigramaSrc}
          alt="Organigrama institucional de la IE El Diamante"
          loading="lazy"
          decoding="async"
        />
      </p>
    </div>
  </main>
  <Footer />
</Layout>
