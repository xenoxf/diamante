---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { noticiasService } from '../../services/noticias.service';
import '../../styles/global.css';
import '../../styles/page.css';

export async function getStaticPaths() {
  return noticiasService.getNoticias().map((n) => ({ params: { slug: n.slug }, props: { noticia: n } }));
}

const { noticia } = Astro.props;
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker={noticia.categoria} title={noticia.titulo} />
    <div class="container">
      <p class="meta">{noticia.fecha} · {noticia.categoria}</p>
      <p class="lead lead--strong">{noticia.resumen}</p>
      <p>
        La Institución Educativa El Diamante invita a la comunidad a mantenerse
        informada a través de los canales oficiales. Los detalles de esta
        publicación se amplían en cada sede y en las comunicaciones dirigidas a
        estudiantes y acudientes.
      </p>
      <p>
        Para mayor información, las personas interesadas pueden acercarse a la
        secretaría de la sede correspondiente en el horario de atención
        establecido.
      </p>
      <p class="back"><a href="/noticias">Volver a todas las noticias</a></p>
    </div>
  </main>
  <Footer />
</Layout>
