---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { noticias } from '../../data/noticias';
import '../../styles/global.css';
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Actualidad" title="Noticias" />
    <div class="container">
      <p class="lead">
        Información oficial sobre actividades académicas, culturales y
        administrativas de la Institución Educativa El Diamante.
      </p>
      <div class="grid">
        {noticias.map((noticia) => (
          <article class="card">
            <p class="meta">{noticia.fecha} · {noticia.categoria}</p>
            <h2>{noticia.titulo}</h2>
            <p class="summary">{noticia.resumen}</p>
            <a class="link" href={`/noticias/${noticia.slug}`}>Leer noticia</a>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page {
    background: #ffffff;
    color: #1a1d21;
    padding-bottom: 4rem;
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }
  .lead {
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 800px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    border: 1px solid #dfe3e8;
    border-top: 4px solid #07b9d5;
    padding: 1.5rem;
  }
  .meta {
    font-size: 0.85rem;
    color: #5a636c;
    margin-bottom: 0.5rem;
  }
  .card h2 {
    font-size: 1.1rem;
    line-height: 1.5;
    margin-bottom: 0.6rem;
  }
  .summary {
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .link {
    font-weight: 700;
    color: #06788a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
