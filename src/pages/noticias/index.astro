---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { noticiasService } from '../../services/noticias.service';
import '../../styles/global.css';
import '../../styles/page.css';

const noticias = noticiasService.getNoticias();
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Actualidad" title="Noticias" />
    <div class="container container--wide">
      <p class="lead">
        Información oficial sobre actividades académicas, culturales y
        administrativas de la Institución Educativa El Diamante.
      </p>
      <div class="grid">
        {noticias.map((noticia) => (
          <article class="card">
            <p class="meta">{noticia.fecha} · {noticia.categoria}</p>
            <h2>{noticia.titulo}</h2>
            <p class="summary">{noticia.resumen}</p>
            <a class="link" href={`/noticias/${noticia.slug}`}>Leer noticia</a>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
