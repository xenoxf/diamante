# Strapi CMS – Configuración para Astro (web)
# Copiar a .env y ajustar según entorno
# En Vercel: Settings > Environment Variables -> definir PUBLIC_STRAPI_URL + STRAPI_URL + SITE_URL

# URL del Strapi (runtime + build). Vercel lee process.env primero, luego import.meta.env
STRAPI_URL=http://localhost:1337
# URL pública expuesta al cliente (debe iniciar con PUBLIC_)
PUBLIC_STRAPI_URL=http://localhost:1337

# Token de API para colecciones protegidas (opcional si permisos públicos)
STRAPI_API_TOKEN=
# PUBLIC_STRAPI_API_TOKEN=  # solo si necesitas token en cliente (no recomendado)

# URL canónica del sitio (para sitemap / SEO)
SITE_URL=https://diamante-nu.vercel.app

# Para desarrollo local, si Strapi no corre, los services harán fallback a /src/data/*
# No es necesario definir token si los permisos públicos están configurados en Strapi
