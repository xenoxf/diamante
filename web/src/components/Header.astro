---
import styles from '../styles/header.module.css';
import { configuracionService } from '../services/configuracion.service';

interface SubLink {
	label: string;
	href: string;
	external?: boolean;
}

interface NavItem {
	label: string;
	href: string;
	children?: SubLink[];
}

// Intentar consumir configuracion-general.enlacesGobierno para el dropdown "Organismo".
// Si Strapi no está disponible, se mantiene hardcode pero documentado.
// Este fetch ocurre en frontmatter (SSR) y hace fallback a null si falla.
let dinamicosEnlacesGobierno: SubLink[] | null = null;
try {
	const cfg = await configuracionService.getConfiguracion();
	if (cfg.enlacesGobierno && cfg.enlacesGobierno.length > 0) {
		dinamicosEnlacesGobierno = cfg.enlacesGobierno.map((e) => ({
			label: e.label,
			href: e.url,
			external: e.externo || e.abrirEnNuevaPestana,
		}));
	}
} catch {
	// Silenciar: fallback hardcode abajo. En dev sin Strapi es esperado.
}

/* Navegación hardcodeada como fallback estable (66 links originales condensados en dropdowns).
   Si Strapi proporciona enlacesGobierno, se usan dinámicos para el ítem "Organismo".
   Para migración completa a CMS, reemplazar este array por un fetch a un Single Type "navegacion-principal"
   o usar directamente cfg.enlacesGobierno + navegación estructurada.
*/
const nav: NavItem[] = [
	{ label: 'Inicio', href: '/' },
	{
		label: 'Identidad',
		href: '/#identidad',
		children: [
			{ label: 'Inscripciones Abiertas', href: '/inscripciones-abiertas' },
			{ label: 'Misión', href: '/mision' },
			{ label: 'Visión', href: '/vision' },
			{ label: 'Valores Institucionales', href: '/valores-institucionales' },
			{ label: 'Manual de Convivencia', href: '/manual-convivencia' },
			{ label: 'Organigrama', href: '/organigrama' },
			{ label: 'P.E.I.', href: '/pei' },
			{ label: 'A Qué Vamos al Colegio', href: '/a-que-vamos-al-colegio' },
			{ label: 'Proyecto Ambiental', href: '/proyecto-ambiental' },
			{ label: 'Nuestras Sedes', href: '/sedes' },
		],
	},
	{ label: 'Sedes', href: '/#sedes' },
	{ label: 'Especialidades', href: '/#especialidades' },
	{ label: 'Noticias', href: '/#noticias' },
	{
		label: 'Servicios',
		href: '/contacto',
		children: [
			{ label: 'Canales de Atención', href: '/canales-de-atencion' },
			{ label: 'Contáctanos', href: '/contacto' },
			{ label: 'Directorio', href: '/directorio' },
			{ label: 'Peticiones, Quejas y Reclamos', href: '/peticiones-quejas-y-reclamos' },
			{ label: 'Denuncias de Corrupción', href: '/denuncias-hechos-de-corrupcion' },
		],
	},
	{
		label: 'Contratación',
		href: '/contratacion',
		children: [
			{ label: 'Invitaciones', href: '/contratacion' },
			{ label: 'Resolución de Matrícula', href: '/resolucion-proceso-de-matricula' },
		],
	},
	{
		label: 'Organismo',
		href: dinamicosEnlacesGobierno?.[0]?.href ?? 'https://www.cali.gov.co/educacion/',
		children: dinamicosEnlacesGobierno ?? [
			{ label: 'Educación', href: 'https://www.cali.gov.co/educacion/' },
			{ label: 'Deporte y Recreación', href: 'https://www.cali.gov.co/deporte/' },
			{ label: 'Paz y Cultura Ciudadana', href: 'https://www.cali.gov.co/pazycultura/' },
			{ label: 'Bienestar Social', href: 'https://www.cali.gov.co/bienestar/' },
		],
	},
];
---

<header id="site-header" class={styles.header} data-scrolled="false" data-open="false">
	

	<div class={styles.mainbar}>
		<div class={styles.mainbarInner}>
			<a href="/" class={styles.brand}>
				<img
					class={styles.logo}
					src="/logo_diamante.png"
					alt=""
					width="56"
					height="56"
				/>
				<span class={styles.name}>
          Institucion Educativa <br> El Diamante
        </span>

	<span class={styles.nam1}>
          Institucion Educativa El Diamante
				</span>		</a>

			<nav id="nav-principal" class={styles.nav} aria-label="Navegación principal">
			<ul class={styles.navList}>
			{nav.map((item, idx) =>
				item.children ? (
					<li>
					<div class={styles.dropdown}>
						<button
							type="button"
							class={styles.link}
							aria-expanded="false"
							aria-controls={`submenu-${idx}`}
						>
							{item.label}
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m6 9 6 6 6-6" />
							</svg>
						</button>
						<ul id={`submenu-${idx}`} class={styles.menu}>
							{item.children.map((sub) => {
								const isExternal = (sub as any).external || sub.href.startsWith('http');
								return (
									<li>
										<a
											href={sub.href}
											class={styles.subLink}
											target={isExternal ? '_blank' : undefined}
											rel={isExternal ? 'noopener noreferrer' : undefined}
										>
											{sub.label}
										</a>
									</li>
								);
							})}
						</ul>
					</div>
					</li>
				) : (
					<li>
					<a class={styles.link} href={item.href}>
						{item.label}
					</a>
					</li>
				),
			)}
			</ul>
			</nav>

			<div class={styles.actions}>
				<button
					id="menu-button"
					class={styles.menuButton}
					type="button"
					aria-label="Abrir menú"
					aria-expanded="false"
					aria-controls="nav-principal"
				>
					<svg class={styles.iconOpen} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
					<svg class={styles.iconClose} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const menuButton = document.getElementById('menu-button');
	const navPrincipal = document.getElementById('nav-principal');

	const syncScrolled = () => {
		if (!header) return;
		header.dataset.scrolled = String(window.scrollY > 8);
	};

	const closeAllAccordions = (except: Element | null = null) => {
		header?.querySelectorAll('nav [aria-expanded="true"]').forEach((btn) => {
			if (btn !== except) btn.setAttribute('aria-expanded', 'false');
		});
	};

	const focusFirstNavItem = () => {
		const first = navPrincipal?.querySelector('a[href], button') as HTMLElement | null;
		first?.focus({ preventScroll: true });
	};

	const setOpen = (open: boolean) => {
		if (!header || !menuButton) return;
		header.dataset.open = String(open);
		menuButton.setAttribute('aria-expanded', String(open));
		menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		if (open) {
			document.body.style.overflow = 'hidden';
			// El foco entra al menú recién abierto (teclado/lectores de pantalla).
			focusFirstNavItem();
		} else {
			document.body.style.overflow = '';
			closeAllAccordions();
		}
	};

	menuButton?.addEventListener('click', () => {
		setOpen(header?.dataset.open !== 'true');
	});

	header?.querySelectorAll('nav a').forEach((anchor) => {
		anchor.addEventListener('click', () => setOpen(false));
	});

	// Acordeón simple: cada pestaña alterna solo su submenu.
	// Sin cierres automáticos ni animaciones para no mover el resto.
	header?.querySelectorAll('nav [aria-controls]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const expanded = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!expanded));
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			const anyAccordion = header?.querySelector('nav [aria-expanded="true"]');
			if (anyAccordion) closeAllAccordions();
			else if (header?.dataset.open === 'true') {
				setOpen(false);
				// Escape devuelve el control al botón que abrió el menú.
				menuButton?.focus({ preventScroll: true });
			}
		}
	});

	document.addEventListener('click', (e) => {
		if (!header || !header.contains(e.target as Node)) {
			closeAllAccordions();
		}
	});

	syncScrolled();
	window.addEventListener('scroll', syncScrolled, { passive: true });
</script>
