---
import { sedesService } from '../services/sedes.service';
import { getStrapiMediaUrl } from '../lib/strapi';
import { readSource } from '../lib/data-source';
import DataSourceBadge from './DataSourceBadge.astro';
import styles from '../styles/sedes.module.css';

let sedes: Awaited<ReturnType<typeof sedesService.getSedes>> = [];
try {
  sedes = await sedesService.getSedes();
} catch (err) {
  console.warn('[Sedes.astro] fallback:', err);
  const { sedes: fallback } = await import('../data/sedes');
  sedes = fallback as any;
}
const source = readSource(sedes);
---
<section id="sedes" class={styles.section} aria-labelledby="sedes-titulo">
  <div class={styles.container}>
    <div class={styles["container-dirs"]}>
      <div class={styles.grid}>
        <div>
          <h2 id="sedes-titulo" class={styles.title}>Nuestras Sedes</h2>
          <div class="rule" aria-hidden="true"></div>
          <figure>
            <img
              class={styles.heroImage}
              src="/niña_apunta.png"
              alt="Estudiante señalando la ubicación de las sedes"
              loading="lazy"
            />
          </figure>
        </div>
        {sedes.map((sede) => {
          const imgSrc = (sede as any).imagenCardUrl ?? getStrapiMediaUrl((sede as any).imagenCard) ?? sede.imgPath ?? '/sedes/sede_principal.png';
          // fallback to local placeholder if media missing
          const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(sede.mapQuery)}&output=embed`;
          return (
            <article class={styles.card} aria-label={sede.nombre}>
              <div class={styles.cardBody}>
                {/* El nombre de la sede ya identifica la tarjeta y el mapa;
                    la imagen no aporta información adicional. */}
                <img class={styles.imgSede} src={imgSrc} alt="" loading="lazy" decoding="async" />
           
              </div>
              <iframe
                class={styles.map}
                src={mapSrc}
                title={`Mapa de ${sede.nombre}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>
