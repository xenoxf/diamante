---
/**
 * Badge de diagnóstico: SOLO visible cuando los datos son fallback local
 * (Strapi falló o no tiene datos).
 * - source="fallback": punto ámbar + "Fallback local · Strapi no disponible"
 * - source="strapi": no renderiza nada (todo normal, sin ruido visual)
 *
 * Uso:
 *   import DataSourceBadge from '../components/DataSourceBadge.astro';
 *   <DataSourceBadge source={source} />
 */
interface Props {
  source: 'strapi' | 'fallback';
  id?: string;
}

const { source = 'fallback', id } = Astro.props as Props;
const isLive = source === 'strapi';
// Si Strapi responde bien, no mostrar nada (solo fallback hace ruido visual).
const label = 'Fallback local · Strapi no disponible';
const title = 'Strapi no respondió o no tiene datos: se muestran datos locales de respaldo';
---

{!isLive && (
<span
  class:list={['ds-badge', 'ds-badge--fallback']}
  title={title}
  data-source={source}
  {...(id ? { id } : {})}
>
  <span class="ds-dot" aria-hidden="true"></span>
  {label}
</span>
)}

<style>
  .ds-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid var(--line-soft, #e5e7eb);
    background: var(--surface, #fff);
    color: var(--ink-soft, #555);
    vertical-align: middle;
  }
  .ds-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    display: inline-block;
    flex: none;
  }
  .ds-badge--fallback .ds-dot {
    background: #d97706;
  }
  .ds-badge--fallback {
    border-color: #fde68a;
  }
</style>
