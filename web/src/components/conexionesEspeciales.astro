---

<div class="container">
    <ul class="list">
        {enlaces.map((enlace) => (
            <a 
                href={enlace.url} 
                class="conexion"
                target={enlace.abrirEnNuevaPestana ? '_blank' : undefined}
                rel={enlace.externo ? 'noopener noreferrer' : undefined}
            >
                <img class="img" src={enlace.iconoUrl || defaultIconSvg} alt={enlace.label}>
            </a>
        ))}
    </ul>
</div>

<style>
    .container {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 1rem 0;
        border-top: 1px solid var(--border);
    }
    .img {
        width: 80px;
    }

    .list {
        width: fit-content;
        display: flex;
        width: 100%;
        padding: 0 1rem;
        justify-content: center;
        gap: 3rem;
    }
</style>