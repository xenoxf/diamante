---
/**
 * Visor único de archivos del sitio.
 * TODAS las páginas que muestren un documento/archivo de Strapi o local
 * deben usar este componente (PDF, Imagen o Enlace).
 */
interface Props {
  src: string;
  title?: string;
  /** PDF | Imagen | Enlace — si no se pasa, se infiere por extensión */
  format?: 'PDF' | 'Imagen' | 'Enlace';
  /** alto del visor, ej "520px" o "70vh" */
  height?: string;
}

const { src, title = 'Documento', format: formatProp, height = '840px' } = Astro.props;

const isImage = formatProp === 'Imagen' || /\.(png|jpe?g|webp|gif|svg)(\?|$)/i.test(src);
const isPdf = formatProp === 'PDF' || /\.pdf(\?|#|$)/i.test(src);
// Enlace externo o formato no embebible: no se usa iframe, se muestra tarjeta de apertura.
const isLink = formatProp === 'Enlace' || (!isImage && !isPdf);
const viewerSrc = isPdf ? `${src}#view=FitH` : src;
const badgeLabel = isPdf ? 'PDF' : isImage ? 'Imagen' : 'Enlace';
---

<div class="fv" style={`--fv-h:${height}`}>
  <div class="fv__toolbar">
    <div class="fv__meta">
      <span class="fv__title">{title}</span>
      <span class="fv__badge">{badgeLabel}</span>
    </div>
    <div class="fv__actions">
      <a class="fv__btn fv__btn--ghost" href={src} target="_blank" rel="noopener noreferrer">
        Abrir en pestaña nueva
      </a>
      {!isLink && (
        <a class="fv__btn fv__btn--primary" href={src} download>
          Descargar
        </a>
      )}
    </div>
  </div>

  <div class="fv__frameWrap">
    {isImage ? (
      <img class="fv__img" src={src} alt={title} loading="lazy" decoding="async" />
    ) : isPdf ? (
      <iframe
        class="fv__frame"
        src={viewerSrc}
        title={title}
        loading="lazy"
        allow="fullscreen"
      ></iframe>
    ) : (
      <div class="fv__linkCard">
        <p class="fv__linkText">Este documento es un enlace externo.</p>
        <a class="fv__btn fv__btn--primary" href={src} target="_blank" rel="noopener noreferrer">
          Abrir {title}
        </a>
      </div>
    )}
  </div>

  <p class="fv__fallback">
    Si no ves el documento aquí, <a href={src} target="_blank" rel="noopener noreferrer">ábrelo en otra pestaña</a> o usa el botón Descargar.
  </p>
</div>

<style>
  .fv {
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--surface);
    /* nunca ocultar el visor: siempre visible en desktop/tablet/móvil */
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .fv__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: var(--wash);
    border-bottom: 1px solid var(--line);
  }

  .fv__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    flex: 1 1 160px;
  }

  .fv__title {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .fv__badge {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--primary-dark);
    background: var(--primary-wash);
    border: 1px solid var(--primary-pale);
    padding: 0.12rem 0.32rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .fv__actions {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .fv__btn {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.38rem 0.68rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid transparent;
    line-height: 1;
    white-space: nowrap;
  }

  .fv__btn--ghost {
    color: var(--ink);
    background: var(--surface);
    border-color: var(--line);
  }

  .fv__btn--ghost:hover {
    border-color: var(--ink-faint);
  }

  .fv__btn--primary {
    color: var(--on-dark);
    background: var(--primary);
    border-color: var(--primary);
  }

  .fv__btn--primary:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
  }

  .fv__frameWrap {
    background: var(--skeleton);
    /* altura fluida: nunca fija 840px en móvil, usa clamp con poco margin */
    height: clamp(360px, 68vh, var(--fv-h));
    max-height: 78vh;
    min-height: 360px;
  }

  .fv__frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: var(--surface);
  }

  .fv__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--surface);
    display: block;
  }

  .fv__linkCard {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 2rem 1.25rem;
    background: var(--surface);
    text-align: center;
  }

  .fv__linkText {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft, #555);
    line-height: 1.6;
  }

  .fv__fallback {
    font-size: 0.78rem;
    color: var(--ink-faint);
    padding: 0.5rem 0.75rem;
    margin: 0;
    line-height: 1.45;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .fv__fallback a {
    color: var(--primary-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 700;
  }

  /* Tablet: poco margin/padding, mantiene visor idéntico */
  @media (max-width: 900px) {
    .fv__toolbar {
      padding: 0.55rem 0.65rem;
      gap: 0.45rem;
    }
    .fv__title {
      font-size: 0.84rem;
    }
    .fv__btn {
      font-size: 0.74rem;
      padding: 0.34rem 0.6rem;
    }
    .fv__fallback {
      padding: 0.45rem 0.65rem;
      font-size: 0.76rem;
    }
  }

  /* Móvil: visor SIEMPRE visible, solo reduce padding/margin, no reemplaza por botón */
  @media (max-width: 640px) {
    .fv__toolbar {
      padding: 0.5rem 0.6rem;
      gap: 0.4rem;
    }
    .fv__meta {
      gap: 0.32rem;
    }
    .fv__title {
      font-size: 0.8rem;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .fv__badge {
      font-size: 0.6rem;
      padding: 0.1rem 0.28rem;
    }
    .fv__actions {
      gap: 0.32rem;
      width: 100%;
      justify-content: flex-start;
    }
    .fv__btn {
      font-size: 0.72rem;
      padding: 0.32rem 0.55rem;
    }
    .fv__frameWrap {
      height: clamp(340px, 62vh, 520px);
      min-height: 340px;
    }
    .fv__fallback {
      padding: 0.45rem 0.6rem;
      font-size: 0.74rem;
    }
  }

  @media (max-width: 380px) {
    .fv__toolbar {
      padding: 0.45rem 0.5rem;
      gap: 0.32rem;
    }
    .fv__btn {
      font-size: 0.7rem;
      padding: 0.3rem 0.5rem;
    }
    .fv__fallback {
      padding: 0.4rem 0.5rem;
    }
    .fv__frameWrap {
      height: clamp(320px, 60vh, 460px);
      min-height: 320px;
    }
  }

  /* Garantía: nunca ocultar iframe/img por breakpoint */
  .fv__frame,
  .fv__img,
  .fv__linkCard,
  .fv__frameWrap {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
</style>
