---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { ciudadaniaService } from '../services/ciudadania.service';
import { configuracionService } from '../services/configuracion.service';
import { sedesService } from '../services/sedes.service';
import '../styles/global.css';
import '../styles/page.css';

const directorio = await ciudadaniaService.getDirectorio();
const sedes = await sedesService.getSedes();
const config = await configuracionService.getConfiguracion();
const paginaContacto = await ciudadaniaService.getPaginaContacto().catch(() => null);
const seo = paginaContacto?.seo ?? config.seoDefault ?? null;
const pageTitle = `Directorio — ${config.nombreInstitucion}`;
const description = 'Directorio de dependencias y coordinaciones de la IE El Diamante (sedes, teléfonos, correos).';
---

<Layout title={pageTitle} description={description} seo={seo}>
  <Header />
  <main class="page">
    <PageHero kicker="Servicios a la ciudadanía" title="Directorio" />
    <div class="container">
      <p class="lead">
        Directorio de dependencias y coordinaciones de la Institución Educativa
        El Diamante para la atención de la comunidad.
      </p>

      {directorio.length === 0 ? (
        <div class="empty" role="status">No hay entradas de directorio disponibles.</div>
      ) : (
        <div class="grid" style="margin-top: 1.5rem;" role="list" aria-label="Directorio institucional">
          {directorio.map((entrada) => (
            <article class="card" role="listitem">
              <h2 style="font-size: 1.05rem; margin: 0 0 0.3rem;">{entrada.dependencia}</h2>
              <p class="barrio" style="margin-bottom: 0.6rem;">{entrada.sede}</p>
              <p style="margin: 0; line-height: 1.7;">
                <a href={`tel:${entrada.telefono.replace(/\s+/g, '')}`} style="color: var(--primary-dark); text-decoration: underline; font-weight: 700;">{entrada.telefono}</a>
                <br />
                <a href={`mailto:${entrada.email}`} style="color: var(--ink-soft); text-decoration: underline;">{entrada.email}</a>
              </p>
            </article>
          ))}
        </div>
      )}

      <section aria-label="Sedes" style="margin-top: 2rem;">
        <h2>Sedes (fuente: sedesService)</h2>
        <ul class="data" role="list">
          {sedes.map((sede) => (
            <li>
              <strong>{sede.nombre}</strong> — {sede.barrio}
              <br />
              <span style="color: var(--ink-soft);">{sede.direccion}</span>
              <br />
              <a href={`tel:${sede.telefono.replace(/\s+/g, '')}`} style="color: var(--primary-dark); text-decoration: underline;">{sede.telefono}</a>
              {' · '}
              <a href={`mailto:${sede.email}`} style="color: var(--primary-dark); text-decoration: underline;">{sede.email}</a>
            </li>
          ))}
        </ul>
      </section>

      <p class="back"><a href="/contacto">Ir al formulario de contacto</a></p>
    </div>
  </main>
  <Footer />
</Layout>
