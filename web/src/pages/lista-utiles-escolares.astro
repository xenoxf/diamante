---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/global.css';
import '../styles/page.css';

const oficial = 'https://www.ie-eldiamantecali.edu.co/lista-utiles-escolares/';
const grados = [
  'Grado Sexto',
  'Grado Séptimo',
  'Grado Octavo',
  'Grado Noveno',
  'Grado Décimo',
  'Grado Once',
];
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Académico" title="Lista de útiles escolares 2026" />
    <div class="container">
      <p class="lead">
        Consulte la lista oficial de útiles escolares por grado para el año
        lectivo 2026, publicada por la Institución Educativa El Diamante.
      </p>
      <p class="note">
        Las listas pueden actualizarse cada año. Confirme en la secretaría de
        su sede antes de realizar las compras.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
