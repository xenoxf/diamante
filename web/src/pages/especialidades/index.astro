---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import DataSourceBadge from '../../components/DataSourceBadge.astro';
import Masonry from '../../components/mansory';
import { especialidadesService } from '../../services/especialidades.service';
import { getStrapiMediaUrl } from '../../lib/strapi';
import { readSource } from '../../lib/data-source';
import { renderRichText } from '../../lib/markdown';
import { setISRHeaders } from '../../lib/isr';
import type { GalleryImage } from '../../types';
import '../../styles/global.css';
import '../../styles/page.css';

setISRHeaders(Astro.response, { sMaxAge: 300 });

let especialidades: Awaited<ReturnType<typeof especialidadesService.getEspecialidades>> = [];
try {
  especialidades = await especialidadesService.getEspecialidades();
} catch (err) {
  console.warn('[especialidades/index] fallback:', err);
  const { especialidades: fallback } = await import('../../data/especialidades');
  especialidades = fallback;
}
const source = readSource(especialidades);
---

<Layout
  title="Especialidades — Institución Educativa El Diamante"
  description="La Institución Educativa El Diamante ofrece formación en distintas especialidades de la educación media, orientadas a la continuidad educativa y a la vinculación al mundo productivo."
>
  <Header />
  <main class="page" id="contenido-principal">
    <PageHero kicker="Oferta académica" title="Especialidades" />
    <div class="container container--wide">
      <p class="lead">
        La Institución Educativa El Diamante ofrece formación en distintas
        especialidades de la educación media, orientadas a la continuidad
        educativa y a la vinculación al mundo productivo.
      </p>
      <div style="margin: 0 0 12px;"><DataSourceBadge source={source} /></div>
      <div class="grid">
        {especialidades.map((esp) => {
          const imgs = esp.images?.length
            ? esp.images
            : ([getStrapiMediaUrl((esp as any).imagenes)].filter(Boolean) as string[]);
          const list = imgs.length > 0 ? imgs : [`/tecnica/${esp.slug}/${esp.slug}_1.jpeg`];
          const fotos: GalleryImage[] = list.map((src, idx) => ({
            id: `${esp.slug}-${idx}`,
            src,
            width: 800,
            height: 600,
            /* El <h2> de la tarjeta nombra la especialidad: la imagen es
               ilustrativa y el CMS no entrega texto alternativo. */
            alt: '',
            href: src,
          }));
          return (
            <article class="card">
              {fotos.length > 1 ? (
                <Masonry fotos={fotos} client:visible />
              ) : (
                <img
                  src={fotos[0].src}
                  alt={fotos[0].alt}
                  loading="lazy"
                  decoding="async"
                  style="width:100%;height:auto;"
                />
              )}
              <h2>{esp.nombre}</h2>
              <div set:html={renderRichText(esp.contenido)} />
              {esp.documentos && esp.documentos.length > 0 && (
                <p style="margin:0.75rem 0;font-size:0.88rem;color:var(--primary-dark);font-weight:600;">
                  📎 {esp.documentos.length} documento{esp.documentos.length > 1 ? 's' : ''} disponible{esp.documentos.length > 1 ? 's' : ''}
                </p>
              )}
              <a class="link" href={`/especialidades/${esp.slug}`}>Ver especialidad</a>
            </article>
          );
        })}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
