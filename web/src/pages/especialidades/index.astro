---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import DataSourceBadge from '../../components/DataSourceBadge.astro';
import EspecialidadCarousel from '../../components/EspecialidadCarousel.tsx';
import { especialidadesService } from '../../services/especialidades.service';
import { getStrapiMediaUrl } from '../../lib/strapi';
import { readSource } from '../../lib/data-source';
import '../../styles/global.css';
import '../../styles/page.css';

let especialidades: Awaited<ReturnType<typeof especialidadesService.getEspecialidades>> = [];
try {
  especialidades = await especialidadesService.getEspecialidades();
} catch (err) {
  console.warn('[especialidades/index] fallback:', err);
  const { especialidades: fallback } = await import('../../data/especialidades');
  especialidades = fallback;
}
const source = readSource(especialidades);
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Oferta académica" title="Especialidades" />
    <div class="container container--wide">
      <p class="lead">
        La Institución Educativa El Diamante ofrece formación en distintas
        especialidades de la educación media, orientadas a la continuidad
        educativa y a la vinculación al mundo productivo.
      </p>
      <div style="margin: 0 0 12px;"><DataSourceBadge source={source} /></div>
      <div class="grid">
        {especialidades.map((esp) => {
          const imgs = esp.images?.length
            ? esp.images
            : ([getStrapiMediaUrl((esp as any).imagenes)].filter(Boolean) as string[]);
          const list = imgs.length > 0 ? imgs : [`/tecnica/${esp.slug}/${esp.slug}_1.jpeg`];
          return (
            <article class="card">
              <EspecialidadCarousel
                images={list}
                alt={`Imagen de ${esp.nombre}`}
                client:visible
              />
              <h2>{esp.nombre}</h2>
              <p>{esp.descripcion}</p>
              {esp.puntos && esp.puntos.length > 0 && (
                <ul style="margin:0.75rem 0 1rem 1.25rem;line-height:1.6;">
                  {esp.puntos.slice(0, 3).map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
              <a class="link" href={`/especialidades/${esp.slug}`}>Ver especialidad</a>
            </article>
          );
        })}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
