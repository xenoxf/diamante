---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import DataSourceBadge from "../../components/DataSourceBadge.astro";
import { especialidadesService } from "../../services/especialidades.service";
import { getStrapiMediaUrls } from "../../lib/strapi";
import { setISRHeaders } from "../../lib/isr";
import { readSource } from "../../lib/data-source";
import Masonry from "../../components/mansory";
import "../../styles/global.css";
import "../../styles/page.css";
import type { GalleryImage } from "../../types";

setISRHeaders(Astro.response, { sMaxAge: 300 });

const slugParam = Astro.params.slug as string;
let especialidad: any = null;
try {
    const fetched = await especialidadesService.getEspecialidadBySlug(String(slugParam));
    if (fetched) especialidad = fetched;
} catch (err) {
    console.warn("[especialidades/[slug]] getEspecialidadBySlug fallback:", err);
}

const documentos = especialidad?.documentos ?? [];
const imagenes: string[] =
    especialidad?.images ??
    getStrapiMediaUrls((especialidad as any)?.imagenes) ??
    [];

const displayImgs: string[] =
    imagenes.length > 0
        ? imagenes
        : especialidad?.slug
          ? [`/tecnica/${especialidad.slug}/${especialidad.slug}_1.jpeg`]
          : [];
const galleryImages: GalleryImage[] = displayImgs.map((src, idx) => ({
    id: `${especialidad?.slug ?? "especialidad"}-${idx}`,
    src,
    width: 800,
    height: 600,
    alt: `${especialidad?.nombre ?? "Especialidad"} imagen ${idx + 1}`,
    href: src,
}));
const detailSource = readSource(especialidad);

function getDocIcon(mime: string) {
    if (mime.includes('pdf')) return '📄';
    if (mime.includes('image')) return '🖼️';
    if (mime.includes('video')) return '🎬';
    if (mime.includes('audio')) return '🎵';
    if (mime.includes('word') || mime.includes('document')) return '📝';
    if (mime.includes('sheet') || mime.includes('excel')) return '📊';
    return '📎';
}
---

<Layout>
    <Header />
    <main class="page">
        {especialidad ? (
            <>
                <PageHero
                    kicker="Oferta académica"
                    title={especialidad.nombre}
                />
                <div class="container">
                    <div style="margin: 0 0 12px;">
                        <DataSourceBadge source={detailSource} />
                    </div>

                    {especialidad.contenido && (
                        <div class="richtext" set:html={especialidad.contenido} />
                    )}

                    {documentos.length > 0 && (
                        <div style="margin-top:2rem;">
                            <h2>Documentos</h2>
                            <ul class="doc-list">
                                {documentos.map((doc: any) => (
                                    <li>
                                        <a
                                            href={doc.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="doc-link"
                                        >
                                            <span class="doc-icon">{getDocIcon(doc.mime)}</span>
                                            <span class="doc-name">{doc.name}</span>
                                            <span class="doc-badge">Abrir</span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}

                    {displayImgs.length > 0 && (
                        <div style="margin-top:2rem;">
                            <h2>Galería</h2>
                            {galleryImages.length > 1 ? (
                                <Masonry fotos={galleryImages} />
                            ) : (
                                <div
                                    class="grid"
                                    style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));"
                                >
                                    {displayImgs.map((src, idx) => (
                                        <img
                                            class="figure-img"
                                            src={src}
                                            alt={`${especialidad.nombre} imagen ${idx + 1}`}
                                            loading="lazy"
                                            decoding="async"
                                            style="height:200px;object-fit:cover;"
                                        />
                                    ))}
                                </div>
                            )}
                        </div>
                    )}

                    {especialidad.duracion && (
                        <p class="meta" style="margin-top:1.5rem;">
                            <strong>Duración:</strong> {especialidad.duracion}
                        </p>
                    )}

                    <p class="back">
                        <a href="/especialidades">
                            Volver a todas las especialidades
                        </a>
                    </p>
                </div>
            </>
        ) : (
            <div class="container">
                <h1>Especialidad no encontrada</h1>
                <p>La especialidad solicitada no existe.</p>
                <p class="back">
                    <a href="/especialidades">
                        Volver a todas las especialidades
                    </a>
                </p>
            </div>
        )}
    </main>
    <Footer />
</Layout>

<style>
  .richtext :global(p) {
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .richtext :global(h2),
  .richtext :global(h3) {
    margin: 2rem 0 1rem;
    font-size: 1.25rem;
  }
  .richtext :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
  .richtext :global(a) {
    color: var(--primary-dark);
    text-decoration: underline;
  }
  .richtext :global(ul),
  .richtext :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    line-height: 1.7;
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: grid;
    gap: 0.75rem;
  }
  .doc-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--wash);
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .doc-link:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 8px rgba(7, 185, 213, 0.12);
  }
  .doc-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
  }
  .doc-name {
    flex: 1;
    font-weight: 600;
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .doc-badge {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary-dark);
    background: var(--primary-wash);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    flex-shrink: 0;
  }
</style>
