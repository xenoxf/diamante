---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import DataSourceBadge from "../../components/DataSourceBadge.astro";
import FileViewer from "../../components/FileViewer.astro";
import { especialidadesService } from "../../services/especialidades.service";
import { getStrapiMediaUrls } from "../../lib/strapi";
import { setISRHeaders } from "../../lib/isr";
import { readSource } from "../../lib/data-source";
import { renderRichText } from "../../lib/markdown";
import Masonry from "../../components/mansory";
import "../../styles/global.css";
import "../../styles/page.css";
import type { GalleryImage } from "../../types";

setISRHeaders(Astro.response, { sMaxAge: 300 });

const slugParam = Astro.params.slug as string;
let especialidad: any = null;
try {
    const fetched = await especialidadesService.getEspecialidadBySlug(String(slugParam));
    if (fetched) especialidad = fetched;
} catch (err) {
    console.warn("[especialidades/[slug]] getEspecialidadBySlug fallback:", err);
}

const documentos = especialidad?.documentos ?? [];
const imagenes: string[] =
    especialidad?.images ??
    getStrapiMediaUrls((especialidad as any)?.imagenes) ??
    [];

const displayImgs: string[] =
    imagenes.length > 0
        ? imagenes
        : especialidad?.slug
          ? [`/tecnica/${especialidad.slug}/${especialidad.slug}_1.jpeg`]
          : [];
const galleryImages: GalleryImage[] = displayImgs.map((src, idx) => ({
    id: `${especialidad?.slug ?? "especialidad"}-${idx}`,
    src,
    width: 800,
    height: 600,
    alt: `${especialidad?.nombre ?? "Especialidad"} imagen ${idx + 1}`,
    href: src,
}));
const detailSource = readSource(especialidad);
---

<Layout>
    <Header />
    <main class="page">
        {especialidad ? (
            <>
                <PageHero
                    kicker="Oferta académica"
                    title={especialidad.nombre}
                />
                <div class="container">
                    <div style="margin: 0 0 12px;">
                        <DataSourceBadge source={detailSource} />
                    </div>

                    {especialidad.contenido && (
                        <div class="richtext" set:html={renderRichText(especialidad.contenido)} />
                    )}

                    {documentos.length > 0 && (
                        <div style="margin-top:2rem;">
                            <h2>Documentos</h2>
                            <div style="display:grid;gap:1rem;margin-top:1rem;">
                                {documentos.map((doc: any) => (
                                    <FileViewer
                                        src={doc.url}
                                        title={doc.name ?? 'Documento'}
                                        height="520px"
                                    />
                                ))}
                            </div>
                        </div>
                    )}

                    {displayImgs.length > 0 && (
                        <div style="margin-top:2rem;">
                            <h2>Galería</h2>
                            {galleryImages.length > 1 ? (
                                <Masonry fotos={galleryImages} />
                            ) : (
                                <div
                                    class="grid"
                                    style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));"
                                >
                                    {displayImgs.map((src, idx) => (
                                        <img
                                            class="figure-img"
                                            src={src}
                                            alt={`${especialidad.nombre} imagen ${idx + 1}`}
                                            loading="lazy"
                                            decoding="async"
                                            style="height:200px;object-fit:cover;"
                                        />
                                    ))}
                                </div>
                            )}
                        </div>
                    )}

                    <p class="back">
                        <a href="/especialidades">
                            Volver a todas las especialidades
                        </a>
                    </p>
                </div>
            </>
        ) : (
            <div class="container">
                <h1>Especialidad no encontrada</h1>
                <p>La especialidad solicitada no existe.</p>
                <p class="back">
                    <a href="/especialidades">
                        Volver a todas las especialidades
                    </a>
                </p>
            </div>
        )}
    </main>
    <Footer />
</Layout>

<style>
  .richtext :global(p) {
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .richtext :global(h2),
  .richtext :global(h3) {
    margin: 2rem 0 1rem;
    font-size: 1.25rem;
  }
  .richtext :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
  .richtext :global(a) {
    color: var(--primary-dark);
    text-decoration: underline;
  }
  .richtext :global(ul),
  .richtext :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    line-height: 1.7;
  }
  .richtext :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }
  .richtext :global(th),
  .richtext :global(td) {
    border: 1px solid var(--line);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .richtext :global(th) {
    background: var(--wash);
    font-weight: 700;
  }
  .richtext :global(blockquote) {
    border-left: 3px solid var(--primary);
    margin: 1.5rem 0;
    padding: 0.5rem 1rem;
    color: var(--ink-soft);
    background: var(--wash);
    border-radius: 0 8px 8px 0;
  }
  .richtext :global(pre) {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .richtext :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.88em;
  }
</style>
