---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { ciudadaniaService } from '../services/ciudadania.service';
import { configuracionService } from '../services/configuracion.service';
import { renderRichText } from '../lib/markdown';
import '../styles/global.css';
import '../styles/page.css';

const paginaContacto = await ciudadaniaService.getPaginaContacto();
const canales = paginaContacto.canales;
const config = await configuracionService.getConfiguracion();
const seo = paginaContacto.seo ?? config.seoDefault ?? null;
const pageTitle = `Canales de atención — ${config.nombreInstitucion}`;
const description = 'Canales de atención de la IE El Diamante: presencial, telefónico, correo y sede electrónica.';
---

<Layout title={pageTitle} description={description} seo={seo}>
  <Header />
  <main class="page">
    <PageHero kicker="Servicios a la ciudadanía" title="Canales de atención" />
    <div class="container">
      <p class="lead">
        La Institución Educativa El Diamante dispone los siguientes canales
        para la atención de estudiantes, acudientes y ciudadanía en general.
      </p>

      {canales.length === 0 ? (
        <div class="empty" role="status">No hay canales configurados en Strapi. Mostrando fallback local.</div>
      ) : (
        <ul class="data" role="list" aria-label="Listado de canales de atención">
          {canales.map((canal) => (
            <li>
              <strong>{canal.nombre}</strong>
              <span style="display: block; margin-top: 0.25rem; line-height: 1.6; color: var(--ink-soft);" set:html={renderRichText(canal.detalle)}></span>
            </li>
          ))}
        </ul>
      )}

      <div class="note" style="margin-top: 1.5rem;">
        <p style="margin: 0; line-height: 1.7;">
          Horario de atención: <span set:html={renderRichText(config.horarioAtencion ?? 'Lunes a viernes 7:00 - 15:00')} />
          <br />
          Correo institucional: <a href={`mailto:${config.emailInstitucional}`} style="color: var(--primary-dark); text-decoration: underline;">{config.emailInstitucional}</a>
          {config.telefonoPrincipal && <> · Tel. <a href={`tel:${config.telefonoPrincipal.replace(/\s+/g, '')}`} style="color: var(--primary-dark); text-decoration: underline;">{config.telefonoPrincipal}</a></>}
        </p>
      </div>

      <p class="back">
        <a href="/contacto">Ir al formulario de contacto</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>
