---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/global.css';
import '../styles/page.css';
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Transparencia" title="Contratación" />
    <div class="container container--wide">
      <p class="lead">
        Invitación pública para llevar a cabo los procesos de contratación
        inferiores a los 20 SMLMV en la Institución Educativa El Diamante, en
        cumplimiento de los principios de transparencia y acceso a la
        información pública.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
