---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { sedesService } from '../../services/sedes.service';
import { getStrapiMediaUrl } from '../../lib/strapi';
import { setISRHeaders } from '../../lib/isr';
import '../../styles/global.css';
import '../../styles/page.css';

setISRHeaders(Astro.response, { sMaxAge: 300 });

// ISR: no getStaticPaths, Vercel genera bajo demanda y cachea 300s.
// El fallback local lo maneja el servicio si Strapi no responde.
const slugParam = Astro.params.sede as string;
let sede: any = null;
try {
  sede = await sedesService.getSedeBySlug(String(slugParam));
} catch (err) {
  console.warn('[sedes/[sede]] getSedeBySlug fallback:', err);
}

if (!sede) {
  // fallback to 404 message; Astro will still render
}

const imagenCardUrl: string | null =
  (sede as any)?.imagenCardUrl ??
  getStrapiMediaUrl((sede as any)?.imagenCard) ??
  sede?.imgPath ??
  null;

const bannerUrl: string | null =
  sede?.bannerUrl ??
  getStrapiMediaUrl((sede as any)?.banner) ??
  null;

const mapQueryRaw: string = sede?.mapQuery ?? sede?.direccion ?? "";
const mapSrc = mapQueryRaw
  ? `https://www.google.com/maps?q=${encodeURIComponent(mapQueryRaw)}&output=embed`
  : "";
---

<Layout
  title={sede ? `${sede.nombre} — Institución Educativa El Diamante` : `Sede — Institución Educativa El Diamante`}
  description={sede ? `${sede.nombre} · ${sede.barrio} · ${sede.direccion} · ${sede.telefono}` : undefined}
>
  <Header />
  <main class="page" id="contenido-principal">
    {sede ? (
      <>
        <PageHero kicker="Nuestras sedes" title={sede.nombre} />
        <div class="container">
          {bannerUrl && (
            <figure>
              <img
                class="figure-img"
                src={bannerUrl}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </figure>
          )}
          {imagenCardUrl && imagenCardUrl !== bannerUrl && (
            <figure>
              <img
                class="figure-img"
                src={imagenCardUrl}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </figure>
          )}

          <dl class="data">
            <div>
              <dt>Barrio</dt>
              <dd>{sede.barrio}</dd>
            </div>
            <div>
              <dt>Dirección</dt>
              <dd>{sede.direccion}</dd>
            </div>
            <div>
              <dt>Teléfono</dt>
              <dd><a href={`tel:${sede.telefono}`}>{sede.telefono}</a></dd>
            </div>
            <div>
              <dt>Correo</dt>
              <dd><a href={`mailto:${sede.email}`}>{sede.email}</a></dd>
            </div>
            <div>
              <dt>Mapa</dt>
              <dd>{sede.mapQuery}</dd>
            </div>
            {sede.horarioAtencion && (
              <div>
                <dt>Horario de atención</dt>
                <dd>{sede.horarioAtencion}</dd>
              </div>
            )}
            {imagenCardUrl && (
              <div>
                <dt>Imagen Card</dt>
                <dd class="meta" style="word-break:break-all;">{imagenCardUrl}</dd>
              </div>
            )}
            {bannerUrl && (
              <div>
                <dt>Banner</dt>
                <dd class="meta" style="word-break:break-all;">{bannerUrl}</dd>
              </div>
            )}
          </dl>

          <h2>Ubicación</h2>
          {mapSrc ? (
            <iframe
              class="map"
              title={`Mapa de ubicación de ${sede.nombre}`}
              src={mapSrc}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          ) : (
            <p class="meta">Mapa no disponible para esta sede.</p>
          )}
          <p class="back"><a href="/sedes">Volver a todas las sedes</a></p>
        </div>
      </>
    ) : (
      <div class="container">
        <h1>Sede no encontrada</h1>
        <p>La sede solicitada no existe.</p>
        <p class="back"><a href="/sedes">Volver a todas las sedes</a></p>
      </div>
    )}
  </main>
  <Footer />
</Layout>
