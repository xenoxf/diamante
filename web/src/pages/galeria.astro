---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import DataSourceBadge from "../components/DataSourceBadge.astro";
import { galeriaService } from "../services/galeria.service";
import { readSource } from "../lib/data-source";
import { setISRHeaders } from "../lib/isr";
import Mansory from "../components/mansory";
import styles from "../styles/galeria.module.css";
import "../styles/global.css";
import "../styles/page.css";

setISRHeaders(Astro.response, { sMaxAge: 180 });

let fotos: Awaited<ReturnType<typeof galeriaService.getGaleriaImages>> = [];
try {
  fotos = await galeriaService.getGaleriaImages(18);
} catch (err) {
  console.warn("[galeria] getGaleriaImages fallback:", err);
  fotos = [];
}
const source = readSource(fotos);
---

<Layout
    title="Galería institucional — Institución Educativa El Diamante"
    description="Registro fotográfico de las actividades académicas, culturales y deportivas de la Institución Educativa El Diamante."
>
    <Header />
    <main class="page" id="contenido-principal">
        <PageHero kicker="Galería" title="Galería institucional" />
        <div class="container container--full">
            <p class="intro">
                Registro fotográfico de las actividades académicas, culturales y
                deportivas de la Institución Educativa El Diamante.
            </p>
            <div style="margin: 0 0 12px;">
                <DataSourceBadge source={source} />
            </div>
            {fotos.length > 0 ? (
                <Mansory fotos={fotos} />
            ) : (
                <p class="empty">No hay imágenes disponibles en este momento.</p>
            )}
        </div>
    </main>
    <Footer />
</Layout>
