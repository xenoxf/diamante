---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { CarruselEvents } from "../components/carruselEvents.tsx";
import { Galeria } from "../components/galeria.tsx";
import Sedes from "../components/Sedes.astro";
import Especialidades from "../components/Especialidades.astro";
import NuestraIdentidad from "../components/NuestraIdentidad.astro";
import Noticias from "../components/Noticias.astro";
import { carruselService } from "../services/carrusel.service";
import Invitaciones from "../components/invitaciones.astro";
import ConexionesEspeciales from "../components/conexionesEspeciales.astro";
import "../styles/global.css";

// Hero / CarruselEvents configurable desde Strapi (Página Inicio > heroSlides)
// Si heroSlides está vacío en Strapi, el servicio hace fallback a colección slides-carrusel.
// SSR para pintar el Hero sin esperar al cliente; el componente hidrata con client:visible.
let heroSlides: Awaited<ReturnType<typeof carruselService.getCarruselSlides>> =
	[];
let heroConfig:
	| Awaited<ReturnType<typeof carruselService.getCarruselConfig>>
	| undefined;
try {
	heroSlides = await carruselService.getCarruselSlides(8);
	heroConfig = { ...carruselService.carruselConfig };
} catch {
	// build sin Strapi (localhost) -> fallback picsum lo maneja el servicio
	heroSlides = [];
}
---

<Layout>
	<Header />
	<div class="app">
		<main class="inicio" id="contenido-principal">
			<h1 class="sr-only">Institución Educativa El Diamante</h1>
			<CarruselEvents
				client:visible
				slides={heroSlides}
				config={heroConfig}
			/>
			<ConexionesEspeciales />
			<Galeria client:visible />
			<Invitaciones />
			<Sedes />
			<Especialidades />
			<NuestraIdentidad />
			<Noticias />
		</main>
	</div>

	<Footer />
</Layout>

<style>
	.app {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.inicio {
		width: 100%;
		max-width: 1500px;
	}

	/* Encabezado de página solo para tecnología de asistencia:
	   el nombre ya visible en el header no se duplica visualmente. */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
