---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FileViewer from '../components/FileViewer.astro';
import { institucionalService } from '../services/institucional.service';
import '../styles/global.css';
import '../styles/page.css';

let doc: any = null;
try {
  doc = await institucionalService.getDocumentoBySlug('proyecto-ambiental');
} catch (err) {
  console.warn('[proyecto-ambiental] Strapi fallback', err);
}
if (!doc) {
  try {
    doc = await institucionalService.getDocumentoById('proyecto-ambiental');
  } catch {}
}
---

<Layout>
  <Header />
  <main class="page">
    <PageHero kicker="Medio ambiente" title="Proyecto ambiental" />
    <div class="container">
      {doc ? (
        <FileViewer src={doc.url} title={doc.titulo ?? 'Proyecto Ambiental Escolar (PRAE)'} format={doc.formato ?? 'PDF'} />
      ) : (
        <p class="empty">Documento no disponible por el momento.</p>
      )}
    </div>
  </main>
  <Footer />
</Layout>
