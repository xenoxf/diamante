---
import SEO from '../components/SEO.astro';

interface SeoInput {
  metaTitle?: string | null;
  metaDescription?: string | null;
  keywords?: string | null;
  canonicalURL?: string | null;
  metaImage?: any;
  noIndex?: boolean | null;
}

interface Props {
  title?: string;
  description?: string;
  seo?: SeoInput | null;
  canonical?: string | null;
  image?: string | null;
  noIndex?: boolean;
  keywords?: string | null;
  ogType?: 'website' | 'article';
  publishedTime?: string | null;
  jsonLd?: Record<string, any> | null;
}

const {
  title = 'Institución Educativa El Diamante | Cali, Colombia',
  description = 'Institución Educativa El Diamante, Santiago de Cali. Educación media técnica, convivencia y formación integral.',
  seo = null,
  canonical = null,
  image = null,
  noIndex = false,
  keywords = null,
  ogType = 'website',
  publishedTime = null,
  jsonLd = null,
} = Astro.props as Props;

// Permitir que seo.metaTitle/metaDescription tengan prioridad sobre props
const effectiveTitle = (seo?.metaTitle || title) as string;
const effectiveDescription = (seo?.metaDescription || description) as string;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<SEO
			title={effectiveTitle}
			description={effectiveDescription}
			seo={seo}
			canonical={canonical}
			image={image}
			noIndex={noIndex}
			keywords={keywords}
			ogType={ogType}
			publishedTime={publishedTime}
			jsonLd={jsonLd}
		/>
		<!--
			Cocoon A11y: capa complementaria de preferencias de accesibilidad
			(voz, tamaño, contraste, dyslexia, daltonismo, pausa de animaciones).
			NO sustituye una base HTML semántica y accesible: es una ayuda adicional
			configurable por cada visitante. Se carga UNA sola vez desde este layout global.
		-->
		<script
			is:inline
			src="https://cdn.jsdelivr.net/gh/ammarahamed/cocoon-a11y@latest/a11y.min.js"
			defer></script>
	</head>
	<body>
		<!-- Skip link: único punto de entrada al contenido principal por teclado -->
		<a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
    background-color: var(--background);
    display: flex;
    flex-direction: column;
    justify-content: center;
	}

	/* Visible solo al recibir foco (teclado) */
	.skip-link {
		position: absolute;
		top: 0;
		left: -9999px;
		z-index: 200;
		background: var(--surface);
		color: var(--primary-deep);
		font-weight: 700;
		padding: 0.75rem 1.25rem;
		border: 2px solid var(--primary);
		border-radius: 0 0 8px 0;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.skip-link:focus {
		left: 0;
	}
</style>
